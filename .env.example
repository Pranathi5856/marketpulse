# Database connection string
DATABASE_URL=postgresql://watchlist:watchlist@localhost:5432/watchlist

# JWT Auth secret key (change for production)
AUTH_SECRET=dev-secret-change-me-in-production

# Finnhub API Key for live quotes, news, and market benchmarks
# Get your free key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Poller intervals (in milliseconds)
POLL_INTERVAL_MS=60000
STATS_REFRESH_INTERVAL_MS=21600000
